# Star Dust secrets. Copy to .env.local. Never commit .env.local.
# Keys stay in the environment. They are not stored in SQLite or Settings.

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional boot default. Settings in the app overrides this after the database exists.
# STAR_DUST_PROVIDER=mock
