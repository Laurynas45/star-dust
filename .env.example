# Star Dust secrets. Copy to .env.local. Never commit .env.local.
# Keys stay in the environment. They are not stored in SQLite or Settings.

# fal.ai — https://fal.ai/dashboard/keys
FAL_KEY=

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional boot default. Settings in the app overrides this after the database exists.
# STAR_DUST_PROVIDER=mock

# Optional hosted credits. Leave every value empty for the free offline studio.
# One-time Stripe Checkout packs. Not a subscription. Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price id for the default pack.
STRIPE_PRICE_CREDITS=
# Credits granted for that price. Empty means 100 when the price id is set.
STRIPE_CREDITS_AMOUNT=
# Optional extra packs, for example:
# STRIPE_PRICE_CREDITS_STUDIO=
# STRIPE_CREDITS_STUDIO=
# Credits charged per second on a paid fal or Replicate Render all. Empty means 1.
# STAR_DUST_CREDITS_PER_SECOND=

# Optional PayPal Checkout for the same one-time credit balance. Not a subscription.
# Leave these empty to hide PayPal. Stripe can stay empty too.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live. Empty means sandbox.
PAYPAL_MODE=
# Amount charged for the default pack. Credits come from PAYPAL_CREDITS_AMOUNT,
# then STRIPE_CREDITS_AMOUNT, then 100.
PAYPAL_PACK_AMOUNT=
PAYPAL_CREDITS_AMOUNT=
# Optional extra packs, for example:
# PAYPAL_PACK_AMOUNT_STUDIO=
# PAYPAL_CREDITS_STUDIO=
# PAYPAL_CURRENCY=USD
# Webhook id for PAYMENT.CAPTURE.COMPLETED. Empty skips the webhook.
# The return URL still captures the order on the server.
# PAYPAL_WEBHOOK_ID=

# Optional self-hosted pack. Empty leaves the MIT core unchanged.
# Any non-empty value unlocks the local worker plan. It is not sent to a server.
STAR_DUST_LICENSE_KEY=
